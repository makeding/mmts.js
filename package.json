{
  "name": "mmts.js",
  "version": "1.8.0-1",
  "description": "HTML5 MPEG2-TS / MMTS / FLV Stream Player",
  "main": "./dist/mpegts.js",
  "types": "./d.ts/mpegts.d.ts",
  "files": [
    "d.ts/mpegts.d.ts",
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xqq/mpegts.js"
  },
  "keywords": [
    "html5",
    "mpegts",
    "m2ts",
    "mse",
    "arib",
    "dvb"
  ],
  "scripts": {
    "build": "webpack --mode=production --progress",
    "build:debug": "webpack --mode=development --progress",
    "serve": "webpack serve --mode=development --progress",
    "test:h265-slice-parser": "node scripts/test_h265_slice_parser.js",
    "test:hevc-poc": "node scripts/test_hevc_poc.js",
    "test:io-range-resume": "node scripts/test_io_range_resume.js",
    "test:mmts-aac-config-remux": "node scripts/test_mmts_aac_config_remux.js",
    "test:mmts-audio-track-switch-window": "node scripts/test_mmts_audio_track_switch_window.js",
    "pretest:mmts-browser": "npm run build",
    "test:mmts-browser": "node scripts/test_mmts_browser_stress.js",
    "pretest:mmts-browser:8k": "npm run build",
    "test:mmts-browser:8k": "node scripts/test_mmts_browser_stress.js --file demo/8k --mode seek --duration 120 --seek-interval 5 --targets 49,51,62,68,75,86,105",
    "pretest:mmts-browser:cocktail": "npm run build",
    "test:mmts-browser:cocktail": "node scripts/test_mmts_browser_stress.js --mode cocktail --duration 1800",
    "test:mmts-demux-remux-timeline": "node scripts/test_mmts_demux_remux_timeline.js",
    "test:mmts-duration-probe": "node scripts/test_mmts_duration_probe.js",
    "test:mmts-gap-check-compare": "node scripts/compare_mmts_gap_check.js",
    "test:mmts-program-packet-loss": "node scripts/test_mmts_program_packet_loss.js",
    "test:mmts-si-signaling": "node scripts/test_mmts_si_signaling.js",
    "test:mmts-startup-group": "node scripts/test_mmts_startup_group.js",
    "test:mmts-subtitle-assembler": "node scripts/test_mmts_subtitle_assembler.js",
    "test:mmts-timestamp-table": "node scripts/test_mmts_timestamp_table.js",
    "test:mmts-tlv-chunking": "node scripts/test_mmts_tlv_chunking.js",
    "test:mmts-video-mpu-assembler": "node scripts/test_mmts_video_mpu_assembler.js",
    "test:mse-buffer-state-machine": "node scripts/test_mse_buffer_state_machine.js",
    "test:mse-controller": "node scripts/test_mse_controller_forward_info.js",
    "test:startup-buffer-gate": "node scripts/test_startup_buffer_gate.js",
    "test:startup-stall-jumper": "node scripts/test_startup_stall_jumper.js",
    "watch": "webpack --mode=development --progress --watch"
  },
  "dependencies": {
    "es6-promise": "^4.2.5"
  },
  "devDependencies": {
    "@types/node": "^10.12.18",
    "@types/express-serve-static-core": "4.17.37",
    "@typescript-eslint/eslint-plugin": "^1.4.2",
    "@typescript-eslint/parser": "^1.4.2",
    "@webpack-cli/serve": "^1.7.0",
    "browser-sync": "^2.26.10",
    "eslint": "^5.15.0",
    "exports-loader": "^0.7.0",
    "file-loader": "^3.0.1",
    "source-map-loader": "^0.2.4",
    "ssri": ">=8.0.1",
    "terser-webpack-plugin": "^1.2.3",
    "ts-loader": "^8.4.0",
    "typescript": "^5.2.2",
    "webpack": "^4.47.0",
    "webpack-cli": "^4.4.0",
    "webpack-dev-server": "^4.9.3",
    "ws": ">=7.4.6",
    "xmlhttprequest-ssl": ">=1.6.2",
    "loader-utils": ">=1.4.1",
    "socket.io-parser": ">=3.3.3",
    "minimist": ">=1.2.6"
  },
  "author": "zheng qian <xqq@xqq.im>",
  "license": "Apache-2.0"
}
